# GameXR keeps motion, camera, XR, framing, and executable-content authority scoped to its public path.
# Inline element styles are required by the touch joystick; inline scripts remain forbidden.
/gamexr/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(self), autoplay=(self), camera=(self), clipboard-read=(), clipboard-write=(), display-capture=(), geolocation=(), gyroscope=(self), magnetometer=(self), microphone=(), payment=(), usb=(), xr-spatial-tracking=(self)
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  ! X-Content-Type-Options
  X-Content-Type-Options: nosniff

# `public, no-transform` blocks zone-level response transformation; Pages Web Analytics must
# also remain disabled because its project-level HTML injection precedes these response headers.
# `no-store` remains authoritative and forbids HTTP-cache storage of mutable release bytes.
/gamexr
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/index.html
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/sw.js
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/manifest.webmanifest
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/precache-manifest.json
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/release-manifest.json
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/llms.txt
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/.well-known/*
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/schemas/*
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/icons/*
  Cache-Control: public, no-store, no-cache, no-transform, must-revalidate, max-age=0

/gamexr/assets/*
  Cache-Control: public, max-age=31536000, immutable, no-transform
