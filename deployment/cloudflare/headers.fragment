# Merge at the protected Pages root owner; later path blocks override cache policy.
/gamexr/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
  Permissions-Policy: accelerometer=(self), autoplay=(self), camera=(self), gyroscope=(self), xr-spatial-tracking=(self)
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/gamexr/index.html
  Cache-Control: no-cache

/gamexr/sw.js
  Cache-Control: no-cache

/gamexr/manifest.webmanifest
  Cache-Control: no-cache

/gamexr/.well-known/*
  Cache-Control: no-cache

/gamexr/assets/*
  Cache-Control: public, max-age=31536000, immutable
